# Local: use a Postgres URL (Neon/Vercel Postgres free tier) or Docker postgres.
# Vercel: add Storage → Postgres; it sets POSTGRES_URL — map it to DATABASE_URL.
DATABASE_URL="postgresql://user:password@localhost:5432/functional_nourishment"
SESSION_SECRET="replace-with-a-long-random-string"
ADMIN_EMAIL="admin@functional-nourishment.com"
ADMIN_PASSWORD="change-this-password"
NEXT_PUBLIC_SITE_URL="https://functional-nourishment.com"
