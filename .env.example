# Neon / Vercel Postgres. Prisma uses DATABASE_URL at runtime and
# DATABASE_URL_UNPOOLED for schema push (required with connection pooling).
DATABASE_URL="postgresql://user:password@host-pooler/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/neondb?sslmode=require"
SESSION_SECRET="replace-with-a-long-random-string"
ADMIN_EMAIL="admin@functional-nourishment.com"
ADMIN_PASSWORD="change-this-password"
NEXT_PUBLIC_SITE_URL="https://functionalnourishment.com"
# Optional: set in Vercel too if you store these as env, otherwise use Site settings in admin.
# BOOKING_URL and portal URLs live in the CMS settings table.

# Vercel Blob — required for event/page photos to persist in production.
# Create a Blob store in the Vercel dashboard and copy BLOB_READ_WRITE_TOKEN.
# On Vercel the serverless filesystem is read-only; uploads will fail with a clear
# error until this token is set. Do not try to write public/uploads in production.
BLOB_READ_WRITE_TOKEN=""

# Resend — required for live form-notification email to Anna's Microsoft 365 inbox.
# Never commit the real key. Without it, forms still save in the admin; email is skipped.
RESEND_API_KEY=""
# Optional verified sending address. Until the Functional Nourishment domain is verified
# in Resend (SPF/DKIM), the Resend onboarding default is used. Reply-To is the visitor.
# FORMS_FROM_EMAIL="Functional Nourishment <forms@functionalnourishment.com>"
# Optional SMTP fallback only if these exist. Do not SMTP directly to Microsoft 365 without auth.
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""

# Optional — used only to generate unpublished journal/recipe drafts in admin.
# Drafts are never auto-published. If unset, admin still creates starter drafts she can edit.
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""
